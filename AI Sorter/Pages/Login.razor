@page "/login"

@inject IJSRuntime JS
@inject HttpClient Http
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider authStateProvider

<PageTitle>AI Sorter - Авторизация</PageTitle>

<section class="container login-wrapper">
    <EditForm Model="loginData" OnValidSubmit="HandleLogin" class="card login-card">
        
        <div>
            <h2>Авторизация</h2>

            <hr />
        </div>
		<DataAnnotationsValidator />
        <div>
            <label>Имя пользователя:</label>
            <InputText id="login_input" @bind-Value="loginData.Login" />
            <ValidationMessage For="@(() => loginData.Login)" />
        </div>

        <div>
            <label>Пароль:</label>
            <InputText id="password_input" @bind-Value="loginData.Password" type="password"/>
            <ValidationMessage For="@(() => loginData.Password)" />
        </div>


        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p style="color:red">@errorMessage</p>
        }
		<button class="button" type="submit">Войти</button>
	</EditForm>
 </section>


@code {
    private LoginRequest loginData = new();
    private string? errorMessage;

    private async Task HandleLogin()
    {
        errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("auth/login", loginData);
            var result = await response.Content.ReadFromJsonAsync<AuthResult>();

            if (response.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "authToken", result.token);
                if (authStateProvider is CustomAuthStateProvider customProvider)
                {
                    customProvider.NotifyUserAuthentication(result.token);
                }
                Navigation.NavigateTo("/");
            }
            else
            {
				errorMessage = response.Content.ReadAsStringAsync().Result;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
        }
    }
}