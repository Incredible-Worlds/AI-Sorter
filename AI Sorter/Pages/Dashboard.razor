@page "/dashboard"
@inject HttpClient Http

@attribute [Authorize(Roles = "admin")]

<div class="sidebar">
    <ul class="menu">
        <li>👥 Пользователи</li>
        <li>⚙️ Настройки</li>
        <li>📄 Логи</li>
        <li>📊 Статистика</li>
    </ul>
</div>


<h3>System Logs</h3>

@if (!string.IsNullOrEmpty(error))
{
    <p style="color:red">@error</p>
}

<textarea style="width: 100%; height: 300px;" readonly>@logs</textarea>

<button @onclick="LoadLogs">Load Logs</button>

@code {
    private string activeSection = "users";

    void SetSection(string section)
    {
        activeSection = section;
    }

    string GetActive(string section) => section == activeSection ? "active" : "";

    private string logs = "";
    private string? error;

    private async Task LoadLogs()
    {
        try
        {
            error = null;
            var response = await Http.GetFromJsonAsync<LogResponse>("logs/getlogs");
            logs = response?.Content ?? "Логи не найдены.";
        }
        catch (Exception ex)
        {
            error = "Ошибка при получении логов: " + ex.Message;
        }
    }

    public class LogResponse
    {
        public string File { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
    }

}
