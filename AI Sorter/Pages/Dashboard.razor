@page "/dashboard"
@inject HttpClient Http
@inject LogService LogService
@attribute [Authorize(Roles = "admin")]

<div class="sidebar">
    <ul class="menu">
        <li>👥 Пользователи</li>
        <li>⚙️ Настройки</li>
        <li>📄 Логи</li>
        <li>📊 Статистика</li>
    </ul>
</div>


<h3>System Logs</h3>

<textarea style="width: 100%; height: 300px;" readonly>@logs</textarea>

<button @onclick="LoadLogs">Load Logs</button>

@code {
    private string activeSection = "users";
    private string logs;


    void SetSection(string section)
    {
        activeSection = section;
    }

    string GetActive(string section) => section == activeSection ? "active" : "";

    private async Task LoadLogs()
    {
        logs = await LogService.GetLogs();
    }
}
