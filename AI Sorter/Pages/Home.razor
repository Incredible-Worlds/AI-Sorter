@page "/"
@using AI_Sorter.Components.CardLoadFile
@using AI_Sorter.Components.CardStatus
@inject MarkdownService MarkdownService
@inject OllamaApiService OllamaApiService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@attribute [Authorize]

<PageTitle>AI Sorter</PageTitle>

<section class="container card-wrapper">
	<AuthorizeView>
		<Authorized>
@* 			@if (userRole == "admin")
			{
				<p>👑 Привет, админ! Ты видишь админский контент.</p>
			} *@
		</Authorized>
	</AuthorizeView>


	<div class="card card-load">
		<CardLoadFile />
	</div>
	<div class="card card-satus">
		<CardStatus/>
	</div>
	<button class="button" @onclick="Logout" style="align-self: start">Выйти</button>

</section>


@code {
	private string? userRole;

	protected override async Task OnInitializedAsync()
	{
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;

		if (user.Identity?.IsAuthenticated == true)
		{
			userRole = user.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
		}
	}

	private async Task Logout()
	{
		await AuthService.LogoutAsync();
		NavigationManager.NavigateTo("/login");
	}
}